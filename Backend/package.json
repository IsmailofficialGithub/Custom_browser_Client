{
  "name": "hostrif-backend",
  "version": "1.0.0",
  "description": "HOSTRIF gRPC Backend with PostgreSQL and Prisma ORM",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "test:grpc": "node test/test-grpc.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
